# Supabase project URL (Dashboard → Project Settings → API). Browser-safe.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public key (Dashboard → Project Settings → API). Browser-safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key — SERVER ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Google Gemini API key (Phase 2: Gemini APIs). SERVER ONLY.
GEMINI_API_KEY=
# Optional: override the default Gemini model name.
GEMINI_MODEL=
# Optional Uplift AI key for Urdu TTS (later phases). SERVER ONLY.
