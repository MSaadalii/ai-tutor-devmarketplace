# Supabase project URL (Dashboard → Project Settings → API). Browser-safe.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public key (Dashboard → Project Settings → API). Browser-safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key — SERVER ONLY, never expose to the browser. Not needed by the current Core flow.
SUPABASE_SERVICE_ROLE_KEY=
# Google Gemini API key (Google AI Studio). SERVER ONLY. Required for diagnose / board / quiz coach.
GEMINI_API_KEY=
# Optional: override the Gemini model name (leave empty for default gemini-3.5-flash-lite).
GEMINI_MODEL=
# Optional: Vapi API key for Play narration. SERVER ONLY, never NEXT_PUBLIC_. Web Speech is used when empty.
VAPI_API_KEY=
# Optional: Vapi assistant id for Play narration. SERVER ONLY.
VAPI_ASSISTANT_ID=
# Optional: Uplift AI key for Urdu TTS (later phase; Web Speech is used when empty). SERVER ONLY.
UPLIFT_AI_API_KEY=
